public class MajorityElement {

    public static int majorityElement(int[] nums) {
        int candidate = 0;
        int count = 0;

        // Первый проход: ищем кандидата
        for (int x : nums) {
            if (count == 0) {
                candidate = x;
                count = 1;
            } else if (x == candidate) {
                count++;
            } else {
                count--;
            }
        }

        // Второй проход: проверяем кандидата
        int cnt = 0;
        for (int x : nums) {
            if (x == candidate) cnt++;
        }

        if (cnt > nums.length / 2) {
            return candidate;
        }
        return -1; // мажоритарного элемента нет
    }

    public static void main(String[] args) {
        int[] nums = {2, 1, 2, 3, 4, 2, 1, 2, 2};
        System.out.println(majorityElement(nums)); // 2
    }
}
